#
# mod-stellar-tarot — configuration
#
# What a server operator tunes. The identifiers the module allocates are not
# settings: they are part of the module, and the installer is what adapts them
# to a server. The catalogue -- cards, boards, tags, effects -- is data in the
# world database, reloaded by `.tarot reload`.
#
# Every value below is also the built-in default, so a setting left out changes
# nothing -- except the StellarTarot.Loot.* lines, read by DynamicLoot when the
# server starts: a family left out drops nothing.
#
# Copy this file to your configs/modules directory and drop the .dist extension.
#

[worldserver]

###############################################################################
#
#    StellarTarot.Enabled
#        Description: Loads the catalogue and answers the .tarot commands.
#                     0 leaves the module compiled in but inert.
#        Default:     1
#

StellarTarot.Enabled = 1

#
#    StellarTarot.Check
#        Description: The measuring instrument. When on, the module lays a
#                     WITNESS aura for every event line the player carries -- a
#                     proc at 100% with no cooldown -- and writes to the log,
#                     every thirty seconds, whether each line keeps what it
#                     promises: its chance, measured against the occasions the
#                     witness counted, and its cooldown, measured as the
#                     shortest gap between two departures.
#                     Meant for a test realm; it costs one aura per event.
#        Default:     0 - (Off)
#                     1 - (On)
#

StellarTarot.Check = 0

###############################################################################
#
#    WHERE CARDS AND BOARDS DROP
#
#    They drop through DynamicLoot, the shared loot extension (the dynamicloot
#    module): without it, the cards work and none of them drops. DynamicLoot
#    sorts every loot source into families -- world creatures, dungeon and
#    raid bosses by expansion, level brackets, gathering nodes, skinning,
#    chests, containers -- and reads the lines below when the server starts.
#    The families and the full syntax are in DynamicLoot's
#    docs/SPECIFICATION.md.
#
#    A LINE is StellarTarot.Loot.<Family> = <draws>:
#
#      <item or list>:<quantity>:<chance>     one draw, the chance in percent
#      a , b                                  b is tried only when a fails
#      a ; b                                  two draws, each with its own dice
#
#    On a list, the quantity is that many distinct draws in the list, one item
#    each; on an item, a stack. A card is item 87000 + its number, a board
#    87500 + its number. A family left out drops nothing; a line that cannot
#    be read is reported at start-up and ignored.
#

# Every card, and every board, of the catalogue
StellarTarot.Loot.cards[0] = [87001, 87002, 87003, 87004, 87005, 87006, 87007, 87008, 87009, 87010, 87011, 87012, 87013, 87014, 87015, 87016, 87017, 87018, 87019, 87020, 87021, 87022, 87023, 87024, 87025, 87026, 87027, 87028, 87029, 87030, 87031, 87032, 87033, 87034, 87035, 87036, 87037, 87038, 87039, 87040, 87041, 87042, 87043, 87044, 87045, 87046, 87047, 87048, 87049, 87050, 87051, 87052, 87053, 87054, 87055, 87056, 87057, 87058, 87059, 87060, 87061, 87062, 87063, 87064, 87065, 87066, 87067, 87068, 87069, 87070, 87071, 87072, 87073, 87074, 87075, 87076, 87077, 87078, 87079, 87080, 87081, 87082, 87083, 87084, 87085, 87086, 87087, 87088, 87089, 87090, 87091, 87092, 87093, 87094, 87095, 87096, 87097, 87098, 87099, 87100, 87101, 87102, 87103, 87104, 87105, 87106, 87107, 87108, 87109, 87110, 87111, 87112, 87113, 87114, 87115, 87116, 87117, 87118, 87119, 87120, 87121, 87122, 87123, 87124, 87125, 87126, 87127, 87128, 87129, 87130, 87131, 87132, 87133, 87134, 87135, 87136, 87137, 87138, 87139, 87140, 87141, 87142, 87143, 87144, 87145, 87146, 87147, 87148, 87149, 87150, 87151, 87152, 87153, 87154, 87155, 87156, 87157, 87158, 87159, 87160, 87161, 87162, 87163, 87164, 87165, 87166, 87167, 87168, 87169, 87170, 87171, 87172, 87173, 87174, 87175, 87176, 87177, 87178, 87179, 87180, 87181, 87182, 87183, 87184, 87185, 87186, 87187, 87188, 87189, 87190, 87191, 87192, 87193, 87194, 87195, 87196, 87197, 87198, 87199, 87200, 87201, 87202, 87203, 87204, 87205, 87206, 87207, 87208, 87209, 87210, 87211, 87212, 87213, 87214, 87215, 87216, 87217, 87218, 87219, 87220, 87221, 87222, 87223, 87224, 87225, 87226, 87227, 87228, 87229, 87230, 87231, 87232, 87233, 87234, 87235, 87236, 87237, 87238, 87239, 87240, 87241, 87242, 87243, 87244, 87245, 87246, 87247, 87248, 87249, 87250, 87251, 87252, 87253, 87254, 87255, 87256, 87257, 87258, 87259, 87260, 87261, 87262, 87263, 87264, 87265, 87266, 87267, 87268, 87269, 87270, 87271, 87272, 87273, 87274, 87275, 87276, 87277, 87278, 87279, 87280, 87281, 87282, 87283, 87284, 87285, 87286, 87287, 87288, 87289, 87290, 87291, 87292, 87293, 87294, 87295, 87296, 87297, 87298, 87299, 87300, 87301, 87302, 87303, 87304, 87305, 87306, 87307, 87308, 87309, 87310, 87311, 87312, 87313, 87314, 87315, 87316, 87317, 87318, 87319, 87320, 87321, 87322, 87323, 87324, 87325, 87326, 87327, 87328, 87329, 87330, 87331, 87332, 87333, 87334, 87335, 87336, 87337, 87338, 87339, 87340, 87341, 87342, 87343, 87344, 87345, 87346, 87347, 87348, 87349, 87350, 87351, 87352, 87353, 87354, 87355, 87356, 87357, 87358, 87359, 87360, 87361, 87362, 87363, 87364, 87365, 87366, 87367, 87368, 87369, 87370, 87371, 87372]
StellarTarot.Loot.boards[0] = [87501, 87502, 87503, 87504, 87505, 87506, 87507, 87508, 87509, 87510, 87511, 87512, 87513, 87514, 87515, 87516, 87517, 87518, 87519, 87520, 87521, 87522, 87523, 87524, 87525]

# How often everything drops: a percentage of the chances written below. 100
# as written, 50 halves them, 1000 multiplies them by ten (a chance is capped
# at 100), 0 turns the module's loot off.
StellarTarot.Loot.Rate = 100

# Any creature of the open world: a card; more often from a rare (a rare of a
# dungeon plays its Rare line as well), always from a world boss.
StellarTarot.Loot.VanillaWorld = cards[0]:1:2
StellarTarot.Loot.VanillaWorldBoss = cards[0]:1:100
StellarTarot.Loot.VanillaRare = cards[0]:1:50
StellarTarot.Loot.BcWorld = cards[0]:1:3
StellarTarot.Loot.BcWorldBoss = cards[0]:1:100
StellarTarot.Loot.BcRare = cards[0]:1:50
StellarTarot.Loot.WotlkWorld = cards[0]:1:3
StellarTarot.Loot.WotlkWorldBoss = cards[0]:1:100
StellarTarot.Loot.WotlkRare = cards[0]:1:50

# The other monsters of dungeons and raids (trash): a card at 2 to 5 %.
StellarTarot.Loot.VanillaDungeonTrash = cards[0]:1:2
StellarTarot.Loot.BcDungeonTrash = cards[0]:1:2
StellarTarot.Loot.WotlkDungeonTrash = cards[0]:1:3
StellarTarot.Loot.WotlkHeroicTrash = cards[0]:1:4
StellarTarot.Loot.VanillaRaidTrash = cards[0]:1:5
StellarTarot.Loot.BcRaidTrash = cards[0]:1:5
StellarTarot.Loot.WotlkRaidTrash = cards[0]:1:5
StellarTarot.Loot.IcecrownRaidTrash = cards[0]:1:5

# A dungeon boss, normal or heroic: a card, and a board, each on its own roll.
StellarTarot.Loot.VanillaDungeonBoss = cards[0]:1:7;boards[0]:1:5
StellarTarot.Loot.BcDungeonBoss = cards[0]:1:10;boards[0]:1:5
StellarTarot.Loot.WotlkDungeonBoss = cards[0]:1:15;boards[0]:1:7
StellarTarot.Loot.WotlkHeroicBoss = cards[0]:1:20;boards[0]:1:10

# A raid boss: cards, on independent rolls; Icecrown bosses a board as well.
StellarTarot.Loot.VanillaRaidBoss = cards[0]:1:15;cards[0]:1:10
StellarTarot.Loot.BcRaidBoss = cards[0]:1:15;cards[0]:1:15
StellarTarot.Loot.WotlkRaidBoss = cards[0]:2:20;cards[0]:1:20
StellarTarot.Loot.IcecrownRaidBoss = cards[0]:3:30;cards[0]:2:15;boards[0]:1:10
